<% content_for :title, "New Category" %>

<div class="max-w-2xl mx-auto p-6">
  <nav class="mb-4">
    <%= link_to categories_path, class: "comic-breadcrumb comic-link text-xl flex items-center" do %>
      <span class="mr-2">←</span>
      ALL CATEGORIES
    <% end %>
  </nav>

  <header class="mb-8 pb-6">
    <h1 class="text-5xl comic-title text-black transform -skew-x-3">NEW CATEGORY</h1>
    <p class="mt-2 text-xl text-gray-600 font-bold">
      Establish a new group to begin comparing and ranking items.
    </p>
  </header>

  <div class="mt-4">
    <%= render "form", category: @category %>
  </div>
</div>

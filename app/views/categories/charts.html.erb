<div class="max-w-4xl mx-auto p-6">

  <%# Header %>
  <nav class="mb-6">
    <%= link_to category_path(@category), class: "comic-breadcrumb comic-link text-lg flex items-center" do %>
      <span class="mr-2">←</span>
      <%= @category.name.upcase %>
    <% end %>
  </nav>

  <header class="mb-8">
    <h1 class="text-5xl comic-title text-black transform -skew-x-3">CHARTS</h1>
    <p class="mt-2 text-xl text-gray-600 font-bold">
      <span class="comic-metadata">TOTAL:</span> <%= @items.count %> ITEMS
    </p>
  </header>

  <%# Bar Chart %>
  <div class="comic-panel p-8 space-y-4">
    <% @items.each_with_index do |item, index| %>
      <% bar_width = ((item.ranking.to_f - @min_rank) / (@max_rank - @min_rank) * 80 + 20).round if @max_rank != @min_rank %>
      <% bar_width = 50 if @max_rank == @min_rank %>
      
      <%# Tier colors %>
      <% if item.ranking >= @max_rank - (@max_rank - @min_rank) * 0.2 %>
        <% bar_color = "bg-[#ef4444]" %>
      <% elsif item.ranking >= @max_rank - (@max_rank - @min_rank) * 0.4 %>
        <% bar_color = "bg-[#f97316]" %>
      <% elsif item.ranking >= @max_rank - (@max_rank - @min_rank) * 0.6 %>
        <% bar_color = "bg-[#facc15]" %>
      <% elsif item.ranking >= @max_rank - (@max_rank - @min_rank) * 0.8 %>
        <% bar_color = "bg-[#22c55e]" %>
      <% else %>
        <% bar_color = "bg-[#3b82f6]" %>
      <% end %>

      <div class="flex items-center gap-4 slam-down" style="animation-delay: <%= index * 0.05 %>s">
        <span class="w-32 text-lg font-bold truncate text-right"><%= item.name %></span>
        <div class="flex-1 h-10 bg-gray-100 border-2 border-black relative">
          <div class="<%= bar_color %> h-full border-r-2 border-black" style="width: <%= bar_width %>%"></div>
          <span class="absolute right-2 top-1/2 -translate-y-1/2 font-black text-sm"><%= item.ranking.to_i %></span>
        </div>
      </div>
    <% end %>
  </div>

  <%# Legend %>
  <div class="mt-8 flex flex-wrap gap-4 justify-center">
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-[#ef4444] border border-black"></div>
      <span class="font-bold text-sm">S - Elite</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-[#f97316] border border-black"></div>
      <span class="font-bold text-sm">A - Great</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-[#facc15] border border-black"></div>
      <span class="font-bold text-sm">B - Good</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-[#22c55e] border border-black"></div>
      <span class="font-bold text-sm">C - Average</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-[#3b82f6] border border-black"></div>
      <span class="font-bold text-sm">D - Below Average</span>
    </div>
  </div>

</div>

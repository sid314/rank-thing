<%# app/views/categories/show.html.erb %>

<div class="max-w-3xl mx-auto p-6">
  <%# Header Section %>
  <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-10 gap-6">
    <div>
      <nav class="mb-2">
        <%= link_to categories_path, class: "comic-breadcrumb comic-link text-lg flex items-center" do %>
          <span class="mr-2">←</span>
          ALL CATEGORIES
        <% end %>
      </nav>
      <h1 class="text-5xl comic-title text-black transform -skew-x-3"><%= @category.name %></h1>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to edit_category_path(@category), 
          class: "comic-btn comic-btn-secondary px-4 py-2.5 rounded-lg text-lg hover:-translate-y-0.5" do %>
        EDIT
      <% end %>

      <%= link_to compare_category_path(@category), 
          class: "comic-btn comic-btn-blue px-4 py-2.5 rounded-lg text-lg hover:-translate-y-0.5" do %>
        COMPARE
      <% end %>

      <%= link_to tiers_category_path(@category), 
          class: "comic-btn bg-[#a855f7] text-white px-4 py-2.5 rounded-lg text-lg hover:-translate-y-0.5" do %>
        TIERS
      <% end %>

      <%= link_to "NEW ITEM",
      new_category_item_path(@category),
      class: "comic-btn comic-btn-primary px-6 py-2.5 rounded-lg text-lg hover:-translate-y-0.5" %>
    </div>
  </div>

  <%# Rankings List Card %>
  <div class="comic-panel">
    <ul class="divide-y-0">
      <% @items.each_with_index do |item, index| %>
        <li class="group transition-colors hover:bg-[#f4f1ea]">
          <%= link_to item_path(item), class: "flex items-center px-6 py-5" do %>

            <%# Rank Badge %>
            <div class="flex-shrink-0 w-16 flex flex-col items-center">
              <% if index == 0 %>
                <span class="comic-star text-4xl mb-1">★</span>
                <span class="text-3xl font-black text-black leading-none text-center comic-title">1</span>
              <% else %>
                <span class="text-2xl font-bold text-gray-400 group-hover:text-[#ef4444] leading-none text-center comic-title">
                  <%= index + 1 %>
                </span>
              <% end %>
            </div>

            <%# Item Info %>
            <div class="ml-4 flex-grow">
              <h3 class="text-2xl font-bold text-black group-hover:text-[#ef4444] comic-title">
                <%= item.name %>
              </h3>
              <p class="text-lg text-gray-600 font-bold">
                <span class="comic-metadata">POWER LEVEL:</span>
                <span class="text-[#3b82f6] font-black"><%= item.ranking.to_i %></span>
              </p>
            </div>

            <%# Navigation Chevron %>
            <div class="ml-4 flex-shrink-0">
              <span class="text-2xl">→</span>
            </div>
          <% end %>
        </li>
      <% end %>

      <% if @items.empty? %>
        <li class="px-6 py-16 text-center">
          <p class="text-3xl comic-title text-gray-400 transform rotate-2">NO ITEMS YET!</p>
          <p class="text-lg text-gray-500 italic">Add your first item to start ranking!</p>
        </li>
      <% end %>
    </ul>
  </div>

  <%# Bottom Danger Zone %>
  <div class="mt-16 pt-8 border-t-4 border-black flex flex-col items-center">
    <p class="comic-btn bg-black text-white px-4 py-1 rounded mb-4 text-sm">DANGER ZONE</p>
    <%= button_to "DELETE CATEGORY",
    category_path(@category),
    method: :delete,
    data: { confirm: "Warning: This will delete the category and every item inside it. Are you sure?" },
    class: "comic-btn comic-danger px-6 py-3 rounded-lg text-lg hover:-translate-y-0.5" %>
  </div>
</div>

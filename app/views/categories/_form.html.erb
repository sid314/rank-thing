<%
if category.persisted?
  form_url = nil
else
  form_url = categories_path
end
%>
<%= form_with(model: category, url: form_url, local: true, class: "space-y-6") do |f| %>

  <% if category.errors.any? %>
    <div class="p-4 rounded-lg bg-[#ef4444] border-2 border-black text-white shadow-[4px_4px_0px_0px_black]">
      <h2 class="text-lg font-black uppercase">
        <%= pluralize(category.errors.count, "error") %> PROHIBITED THIS CATEGORY FROM BEING SAVED:
      </h2>
      <ul class="mt-2 list-disc list-inside text-sm font-bold">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="comic-panel p-8 space-y-5">
    <div>
      <%= f.label :name, "CATEGORY NAME", class: "block text-xl font-bold text-black mb-2" %>
      <%= f.text_field :name,
                   placeholder: "e.g. ELECTRONICS, FAVORITE MOVIES, ETC.",
                   class: "comic-input block w-full px-4 py-3 rounded-lg text-xl font-bold" %>
      <p class="mt-2 text-lg text-gray-600 font-bold">Give your category a unique name to help group your items.</p>
    </div>

    <div class="pt-6 flex items-center gap-4 border-t-2 border-black mt-6">
      <%= f.submit "SAVE CATEGORY", class: "comic-btn comic-btn-primary px-8 py-3 rounded-lg text-xl hover:-translate-y-0.5" %>
      <%= link_to "CANCEL", categories_path, class: "comic-btn comic-btn-secondary px-6 py-3 rounded-lg text-xl hover:-translate-y-0.5" %>
    </div>
  </div>
<% end %>

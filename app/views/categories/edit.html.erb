<% content_for :title, "Editing #{@category.name_was || "Category"}" %>

<div class="max-w-2xl mx-auto p-6">
  <nav class="mb-6">
    <%= link_to category_path(@category), class: "comic-breadcrumb comic-link text-xl flex items-center" do %>
      <span class="mr-2">←</span>
      <%= (@category.name_was || @category.name).upcase %>
    <% end %>
  </nav>

  <header class="mb-8 pb-6">
    <h1 class="text-5xl comic-title text-black transform -skew-x-3">EDIT CATEGORY</h1>
  </header>

  <div class="mt-4">
    <%= render "form", category: @category %>
  </div>

  <div class="mt-10 pt-6 border-t-4 border-black flex justify-center gap-6">
    <%= link_to "VIEW CATEGORY", category_path(@category), class: "comic-btn comic-btn-blue px-6 py-3 rounded-lg text-lg hover:-translate-y-0.5" %>
    <%= link_to "ALL CATEGORIES", categories_path, class: "comic-btn comic-btn-secondary px-6 py-3 rounded-lg text-lg hover:-translate-y-0.5" %>
  </div>
</div>

<div id="<%= dom_id item %>" class="space-y-4">
  <div class="border-b-2 border-black pb-4">
    <dt class="text-lg font-bold text-gray-500 uppercase tracking-wider">NAME</dt>
    <dd class="mt-1 text-4xl comic-title text-black transform -skew-x-3"><%= item.name %></dd>
  </div>

  <div class="flex items-center gap-3">
    <span class="text-lg font-bold text-gray-500 uppercase">POWER LEVEL:</span>
    <span class="bg-[#3b82f6] text-white px-4 py-2 rounded-lg text-xl font-black border-2 border-black">
      <%= item.ranking.to_i %>
    </span>
  </div>
</div>

<div class="max-w-2xl mx-auto p-6">
  <div class="comic-panel overflow-hidden mb-8">
    <div class="p-8">
      <%= render @item %>
    </div>

    <div class="bg-[#f4f1ea] px-8 py-4 flex items-center justify-between border-t-2 border-black">
      <%= link_to category_path(@item.category), class: "comic-breadcrumb comic-link text-xl flex items-center" do %>
        <span class="mr-2">←</span>
        <%= @item.category.name.upcase %>
      <% end %>

      <%= link_to "EDIT ITEM", edit_item_path(@item), class: "comic-btn comic-btn-secondary px-6 py-2.5 rounded-lg text-lg hover:-translate-y-0.5" %>
    </div>
  </div>

  <div class="pt-8 border-t-4 border-black">
    <div class="comic-panel p-6">
      <div class="flex items-center justify-between">
        <div class="flex items-start gap-3">
          <div>
            <h3 class="text-2xl comic-title text-[#ef4444] transform rotate-2">DELETE ITEM</h3>
            <p class="text-lg text-gray-600 font-bold">
              This will remove <strong><%= @item.name %></strong> from
              <strong><%= @item.category.name %></strong>.
            </p>
          </div>
        </div>

        <%= button_to "DELETE", @item, 
        method: :delete, 
        data: { confirm: "Are you sure?" },
        class: "comic-btn bg-[#ef4444] text-white px-6 py-3 rounded-lg text-xl hover:-translate-y-0.5" %>
      </div>
    </div>
  </div>
</div>

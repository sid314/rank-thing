<% content_for :title, "Editing #{@item.name_was || "Item"}" %>

<div class="max-w-2xl mx-auto p-6">
  <nav class="flex items-center space-x-4 mb-6">
    <% if @item.category.present? %>
      <%= link_to category_path(@item.category), class: "comic-breadcrumb comic-link text-xl flex items-center" do %>
        <span class="mr-2">←</span>
        <%= @item.category.name.upcase %>
      <% end %>
    <% end %>
    <%= link_to @item.name.upcase, item_path(@item), class: "comic-breadcrumb comic-link text-xl" %>
  </nav>

  <header class="mb-8 pb-6">
    <h1 class="text-5xl comic-title text-black transform -skew-x-3">EDIT ITEM</h1>
  </header>

  <div class="mt-4">
    <%= render "form", item: @item %>
  </div>

  <div class="mt-8 text-center">
    <% back_path = @item.category ? category_path(@item.category) : categories_path %>
    <%= link_to "← BACK", back_path, class: "comic-btn comic-btn-secondary px-6 py-3 rounded-lg text-xl hover:-translate-y-0.5" %>
  </div>
</div>

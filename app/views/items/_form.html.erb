<%
if item.persisted?
  form_url = nil
else
  form_url = @category ? category_items_path(@category) : items_path
end
%>
<%= form_with(model: item, url: form_url, local: true, class: "space-y-6") do |form| %>

  <% if item.errors.any? %>
    <div class="p-4 rounded-lg bg-[#ef4444] border-2 border-black text-white shadow-[4px_4px_0px_0px_black]">
      <h2 class="text-lg font-black uppercase">
        <%= pluralize(item.errors.count, "error") %> PROHIBITED THIS ITEM FROM BEING SAVED:
      </h2>
      <ul class="mt-2 list-disc list-inside text-sm font-bold">
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="comic-panel p-8 space-y-5">
    <div>
      <%= form.label :name, "ITEM NAME", class: "block text-xl font-bold text-black mb-2" %>
      <%= form.text_field :name,
                      placeholder: "e.g. SPIDER-MAN, BATMAN, ETC.",
                      class: "comic-input block w-full px-4 py-3 rounded-lg text-xl font-bold" %>
    </div>

    <% if @category %>
      <%= form.hidden_field :category_id, value: @category.id %>
    <% else %>
    <div>
      <%= form.label :category_id, "SELECT CATEGORY", class: "block text-xl font-bold text-black mb-2" %>
      <div class="relative">
        <%= form.collection_select :category_id,
                               Category.all,
                               :id,
                               :name,
                               { prompt: "SELECT A CATEGORY" },
                               { class: "comic-input block w-full px-4 py-3 rounded-lg text-xl font-bold" } %>
      </div>
    </div>
    <% end %>

    <div class="pt-6 flex items-center gap-4 border-t-2 border-black mt-6">
      <%= form.submit "SAVE ITEM", class: "comic-btn comic-btn-primary px-8 py-3 rounded-lg text-xl hover:-translate-y-0.5" %>
      <%= link_to "CANCEL", @category || categories_path, class: "comic-btn comic-btn-secondary px-6 py-3 rounded-lg text-xl hover:-translate-y-0.5" %>
    </div>
  </div>
<% end %>

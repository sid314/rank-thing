<% content_for :title, "New Item" %>

<div class="max-w-2xl mx-auto p-6">
  <nav class="mb-4">
    <% if @category %>
      <%= link_to category_path(@category), class: "comic-breadcrumb comic-link text-xl flex items-center" do %>
        <span class="mr-2">←</span>
        <%= @category.name.upcase %>
      <% end %>
    <% else %>
      <%= link_to categories_path, class: "comic-breadcrumb comic-link text-xl flex items-center" do %>
        <span class="mr-2">←</span>
        ALL CATEGORIES
      <% end %>
    <% end %>
  </nav>

  <header class="mb-8 pb-6">
    <h1 class="text-5xl comic-title text-black transform -skew-x-3">NEW ITEM</h1>
    <% if @category %>
      <p class="mt-2 text-xl text-[#3b82f6] font-bold"><span class="comic-metadata">ADDING TO:</span> <%= @category.name.upcase %></p>
    <% else %>
      <p class="mt-2 text-xl text-gray-600 font-bold">Enter a name and select a category.</p>
    <% end %>
  </header>

  <div class="mt-4">
    <%= render "form", item: @item %>
  </div>
</div>

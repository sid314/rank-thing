<div class="max-w-2xl mx-auto px-6 mt-4">
  <% flash.each do |type, message| %>
    <% if type == "notice" || type == "success" %>
      <div class="comic-flash comic-flash-notice p-4 mb-4 rounded-lg flex items-center transform rotate-1" role="alert">
        <span class="text-2xl mr-3">✓</span>
        <div class="text-lg font-bold tracking-wide"><%= message %></div>
      </div>
    <% elsif type == "alert" || type == "error" %>
      <div class="comic-flash comic-flash-alert p-4 mb-4 rounded-lg flex items-center transform -rotate-1" role="alert">
        <span class="text-2xl mr-3">⚠</span>
        <div class="text-lg font-bold tracking-wide"><%= message %></div>
      </div>
    <% end %>
  <% end %>
</div>
